{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "libretv",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "tv.cqfly.xyz",
      "custom_domain": true
    }
  ]
}
